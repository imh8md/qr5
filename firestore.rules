// قواعد Firestore المقترحة — تُلصق في Firebase Console ← Firestore ← Rules
// شرطها: إضافة FIREBASE_SERVICE_ACCOUNT في أسرار GitHub أولاً (سكربت الإشعارات يتجاوز القواعد بحساب الخدمة)،
// ملاحظة: لا توقف الدخول المجهول (Anonymous) — صفحة التسعيرة للزبائن تحتاجه، والقواعد تحصره في إرسال طلب تسعيرة فقط.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth != null && request.auth.token.email is string ? request.auth.token.email : ''; }
    function isAdmin() { return email() == 'admin@qrawi.app'; }
    function isBranchUser() { return email().matches('^b[0-9]+@qrawi[.]app$'); }
    function isStaff() { return isAdmin() || isBranchUser(); }
    function isBranch(id) { return email() == 'b' + string(id) + '@qrawi.app'; }

    // طلبات القطع: الفروع ترد على الطلبات الموجّهة لها، فالتحديث لكل الموظفين
    match /requests/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() || isBranch(request.resource.data.from);
      allow update: if isStaff();
      allow delete: if isAdmin() || isBranch(resource.data.from);
    }
    // الحوالات: الفرع يرفع، الإدارة فقط تؤكد/ترفض
    match /transfers/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() || isBranch(request.resource.data.branchId);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isBranch(resource.data.branchId) && resource.data.status == 'pending');
    }
    match /transfer_images/{id} {
      allow read, create, delete: if isStaff();
    }
    // المستلزمات: الفرع يطلب، الإدارة توفّر
    match /supplies/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() || isBranch(request.resource.data.branchId);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isBranch(resource.data.branchId) && resource.data.status != 'done');
    }
    match /arrivals/{id} {
      allow read, create: if isStaff();
    }
    // اشتراكات الإشعارات: كتابة فقط (القراءة لسكربت الإشعارات عبر حساب الخدمة)
    match /subs/{id} {
      allow create, update: if isStaff();
    }
    // إضافات الكتالوج: الفرع يقترح (pending)، الإدارة تعتمد/تحذف
    match /catalog_adds/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() || (isBranch(request.resource.data.branchId) && request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }
    // طلبات التسعيرة من الزبائن (صفحة quote.html): الزبون يدخل دخولاً مجهولاً ويقدر «يرسل» فقط
    // لذلك لا تُوقف Anonymous من Authentication — هذي القاعدة تحصره في إنشاء طلب تسعيرة بحقول محددة
    match /quotes/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['id','t','status','notified','source','branchId','name','phone','make','model','year','km','vin','items','extra','no'])
        && request.resource.data.no == getAfter(/databases/$(database)/documents/counters/quotes).data.n
        && request.resource.data.status == 'new' && request.resource.data.notified == false
        && request.resource.data.phone is string && request.resource.data.phone.matches('^05[0-9]{8}$')
        && request.resource.data.branchId is int && request.resource.data.branchId >= 1 && request.resource.data.branchId <= 50
        && request.resource.data.items is list && request.resource.data.items.size() <= 40
        && request.resource.data.extra is string && request.resource.data.extra.size() <= 600
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow read: if isAdmin() || isBranch(resource.data.branchId);
      allow update: if isAdmin() || isBranch(resource.data.branchId);
      allow delete: if isAdmin();
    }
    // عدّاد أرقام طلبات التسعيرة (1، 2، 3…): يزيد بواحد فقط، مع إنشاء طلب في نفس العملية
    match /counters/quotes {
      allow read: if request.auth != null;
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }
    // سجل النشاط: يُكتب ولا يُعدّل، والإدارة فقط تقرأه
    match /activity/{id} {
      allow create: if isStaff();
      allow read: if isAdmin();
    }
  }
}
